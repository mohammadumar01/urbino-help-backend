# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5500

# Frontend URL(s) allowed by CORS, comma-separated
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=Urbino_help
DB_POOL_MAX=20
DB_SSL=false

# Auth: use a long random string (min 32 chars in production)
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Redis (cache only; app keeps working if Redis is down)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

# Rate limits
RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT=30

# Run DB migrations on startup (set false if you run `npm run migrate` separately)
RUN_MIGRATIONS=true

# AI chatbot
OPENAI_API_KEY=

# Payments (Razorpay). Without keys, development uses a built-in test gateway;
# production without keys allows cash only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_COMMISSION_PERCENT=15
